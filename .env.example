# Отдельная база PostgreSQL для выбранного окружения.
DATABASE_URL="postgresql://user:pass@localhost:5432/vizual?schema=public"

# Ключ доступа к CRM Topnlab. Не коммить реальное значение.
TOPNLAB_KEY="заменить-на-реальный-ключ"
TOPNLAB_BASE_URL="https://agencies-p.topnlab.ru"

# Публичный адрес сайта — для sitemap, robots и ссылок в соцсетях.
SITE_URL="https://nedvizhimostdoneck.ru"

# Точный origin без завершающего слеша для проверки изменяющих admin-запросов.
SITE_ORIGIN="http://localhost:3000"

# Один серверный логин администратора. Пароль в открытом виде не хранится.
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""

# Случайный секрет cookie-сессии, минимум 32 байта. Не коммить значение.
ADMIN_SESSION_SECRET=""

# Необязательно: длительность сессии в часах; по умолчанию 12.
ADMIN_SESSION_TTL_HOURS="12"

# Абсолютная постоянная папка вне Git и каталога приложения.
TEAM_UPLOAD_DIR="C:/vizual-data/team-uploads"
